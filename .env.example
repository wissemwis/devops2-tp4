# Copier ce fichier en .env :  cp .env.example .env
# Ne JAMAIS commiter le fichier .env
# Valeurs prêtes à l'emploi pour le TP (développement local uniquement).
# En production, régénérer chaque secret avec :  openssl rand -base64 16

# ---------- PostgreSQL ----------
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=strapi-tp2-pg

# ---------- pgAdmin ----------
# Domaine non réservé obligatoire (pas de .local ni .test)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin-tp2

# ---------- Strapi ----------
APP_KEYS=vKHF0/Gxc/W0QVQ3xlDrHA==,RFUp+54vJvS14jz01v3MMg==,z3IGHRC2zGTMlkRSzYpKCg==,vbRAfara76SfIwaB3trihA==
API_TOKEN_SALT=04bsVkBWNx304n4zDAxaBw==
ADMIN_JWT_SECRET=nhPTU0esMilqZlTy9FipMA==
JWT_SECRET=sanZHZWNKYkTgFeYMv/bxA==
TRANSFER_TOKEN_SALT=yPuW4OB/nCAJCoCYpOlmiw==
ENCRYPTION_KEY=ov9GH8UuL183OXtzIkAW6g==
STRAPI_CLIENT_PASSWORD=change-moi

# ---------- Ports exposés sur la machine hôte ----------
FRONTEND_PORT=3000
STRAPI_PORT=1337
PGADMIN_PORT=5050

# ---------- SonarQube ----------
SONAR_PORT=9000
# Jeton généré dans SonarQube (Mon compte → Sécurité) — partie 6
SONAR_TOKEN=

# ---------- Nexus ----------
NEXUS_VERSION=3.96.5
# Mémoire de Nexus : à réduire avec prudence (en dessous de 2g, Nexus devient instable)
NEXUS_JVM_PARAMS="-Xms1g -Xmx1g -XX:MaxDirectMemorySize=512m -Djava.util.prefs.userRoot=/nexus-data/javaprefs"
NEXUS_MEM_LIMIT=2g

# ---------- Client npm (Linux uniquement) ----------
# Si "id -u" n'affiche pas 1000, mettez ici la sortie de "id -u" et "id -g".
HOST_UID=1000
HOST_GID=1000

# ---------- Publication npm (partie 1) ----------
# Identifiants de l'utilisateur deployer encodés en base64 :
#   printf 'deployer:VOTRE_MOT_DE_PASSE' | base64
# Ce fichier .env n'est JAMAIS commité.
NPM_AUTH=
